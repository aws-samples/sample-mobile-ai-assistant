source 'https://rubygems.org'

# ActiveSupport 8's security fixes require Ruby 3.2 or newer.
ruby ">= 3.2.0"

# Keep the existing CocoaPods release. The local Core copy only changes its
# dependency metadata to allow the fixed ActiveSupport 8.0 branch.
# See vendor/cocoapods-core/PATCHES.md for provenance and removal criteria.
gem 'cocoapods', '1.14.3'
gem 'cocoapods-core', '1.14.3', path: 'vendor/cocoapods-core'
gem 'activesupport', '>= 8.0.5.2', '< 8.1'

group :test do
  gem 'minitest', '~> 5.27'
end
